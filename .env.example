# HTTP agent - chi nghe loopback, truy cap tu ngoai di qua cloudflared + Access
PORT=9100
STATION=kho-bd

# May in va duong dan chuong trinh
PRINTER_NAME=SP46 (Copy 1)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
SUMATRA_PATH=C:\Users\ADMIN\AppData\Local\SumatraPDF\SumatraPDF.exe

# Ngan sach cho may in nha het tem = BASE + PER_PAGE * so_tem (SP46 ~1.2s/tem).
# Mac dinh 8000 + 1800*n: lo 14 tem cho toi 33s, lo 18 tem cho toi 40s.
PRINT_VERIFY_BASE_MS=8000
PRINT_VERIFY_PER_PAGE_MS=1800
# PDF tai truc tiep khong dem duoc so trang -> gia dinh lo co nay
PRINT_VERIFY_UNKNOWN_PAGES=20
# Het ngan sach VA queue dung yen bay nhieu lau -> ket that, huy job + bao loi
PRINT_STALL_TIMEOUT_MS=15000
# Tran tuyet doi cho ca vong verify
PRINT_VERIFY_MAX_MS=180000

# Thong bao Zalo khi in loi (qua zalo-bridge)
ZALO_BRIDGE_URL=https://zb.dilisupplement.com/send
ZALO_BRIDGE_KEY=<bridge_key>
ZALO_THREAD_ID=<thread_id>
ZALO_THREAD_TYPE=group
